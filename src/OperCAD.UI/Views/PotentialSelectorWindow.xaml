<Window x:Class="OperCAD.UI.Views.PotentialSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seleção de Potencial"
        Width="420" Height="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App.Background}"
        FontFamily="{StaticResource App.Font}">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Selecione dois condutores para mesclar seus potenciais"
                   Foreground="{DynamicResource App.Text.Primary}" Margin="0,0,0,8" FontSize="12" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Lista 1: Potencial de origem -->
            <DockPanel Grid.Column="0" Margin="0,0,6,0">
                <TextBlock DockPanel.Dock="Top" Text="Potencial de origem:"
                           Foreground="{DynamicResource App.Text.Secondary}" FontSize="11" Margin="0,0,0,4" />
                <ListBox x:Name="LstSourceColors" Background="Transparent" BorderThickness="1"
                         BorderBrush="{DynamicResource App.Divider}"
                         Foreground="{DynamicResource App.Text.Primary}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}" />
                            <Setter Property="Padding" Value="6,3" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>

            <!-- Botão Mesclar no centro -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button Content="→" Width="32" Height="28" Click="OnMergeClick"
                        ToolTip="Mesclar potencial selecionado"
                        FontSize="14" FontWeight="Bold"
                        Background="{DynamicResource App.Accent}" Foreground="White"
                        FontFamily="{StaticResource App.Font}" BorderThickness="0" />
            </StackPanel>

            <!-- Lista 2: Potencial de destino -->
            <DockPanel Grid.Column="2" Margin="6,0,0,0">
                <TextBlock DockPanel.Dock="Top" Text="Potencial de destino:"
                           Foreground="{DynamicResource App.Text.Secondary}" FontSize="11" Margin="0,0,0,4" />
                <ListBox x:Name="LstTargetColors" Background="Transparent" BorderThickness="1"
                         BorderBrush="{DynamicResource App.Divider}"
                         Foreground="{DynamicResource App.Text.Primary}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}" />
                            <Setter Property="Padding" Value="6,3" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Mesclar" Click="OnMergeClick" Width="88" Height="30"
                    Background="{DynamicResource App.Accent}" Foreground="White"
                    FontFamily="{StaticResource App.Font}" BorderThickness="0" />
            <Button Content="Cancelar" IsCancel="True" Click="OnCancelClick" Width="88" Height="30" Margin="8,0,0,0"
                    Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                    FontFamily="{StaticResource App.Font}" BorderBrush="{DynamicResource App.Border}" />
        </StackPanel>
    </Grid>
</Window>
