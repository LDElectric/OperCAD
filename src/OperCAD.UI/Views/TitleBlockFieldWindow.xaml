<Window x:Class="OperCAD.UI.Views.TitleBlockFieldWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar legenda"
        Width="430" Height="210"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource App.Background}"
        FontFamily="{StaticResource App.Font}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="LblField" Style="{StaticResource App.SectionHeader}" />
        <TextBlock x:Name="LblLimit" Grid.Column="1" HorizontalAlignment="Right"
                   Foreground="{DynamicResource App.Text.Secondary}" VerticalAlignment="Center" />
        <TextBox x:Name="TxtValue" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                 Style="{StaticResource App.TextBox}" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" MaxLength="200" />

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" IsDefault="True" Click="OnOk"
                    Style="{StaticResource App.PrimaryButton}" Width="88" Height="28" />
            <Button Content="Cancelar" IsCancel="True" Width="88" Height="28" Margin="8,0,0,0"
                    Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                    BorderBrush="{DynamicResource App.Border}" />
        </StackPanel>
    </Grid>
</Window>
