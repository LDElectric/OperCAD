<Window x:Class="OperCAD.UI.Views.ElementEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OperCAD.UI.Controls"
        Title="Editor de elementos"
        Width="1060" Height="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App.Background}"
        FontFamily="{StaticResource App.Font}">

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="Undo" />
        <KeyBinding Key="Y" Modifiers="Control" Command="Redo" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de ferramentas -->
        <Border Grid.Row="0" Style="{StaticResource App.ToolBar}">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource App.ToolButton}" ToolTip="Novo elemento" Click="OnNew">
                    <Image Source="{StaticResource Icon.New}" Width="18" Height="18" />
                </Button>
                <Rectangle Style="{StaticResource App.ToolSeparator}" />
                <Button x:Name="BtnUndo" Style="{StaticResource App.ToolButton}" ToolTip="Desfazer (Ctrl+Z)" Click="OnUndo">
                    <Image Source="{StaticResource Icon.Undo}" Width="18" Height="18" />
                </Button>
                <Button x:Name="BtnRedo" Style="{StaticResource App.ToolButton}" ToolTip="Refazer (Ctrl+Y)" Click="OnRedo">
                    <Image Source="{StaticResource Icon.Redo}" Width="18" Height="18" />
                </Button>
                <Rectangle Style="{StaticResource App.ToolSeparator}" />
                <Button Style="{StaticResource App.ToolButton}" ToolTip="Adicionar linha" Click="OnLine">
                    <Image Source="{StaticResource Icon.Line}" Width="18" Height="18" />
                </Button>
                <Button Style="{StaticResource App.ToolButton}" ToolTip="Adicionar retângulo" Click="OnRect">
                    <Image Source="{StaticResource Icon.Rect}" Width="18" Height="18" />
                </Button>
                <Button Style="{StaticResource App.ToolButton}" ToolTip="Adicionar elipse" Click="OnEllipse">
                    <Image Source="{StaticResource Icon.Ellipse}" Width="18" Height="18" />
                </Button>
                <Button Style="{StaticResource App.ToolButton}" ToolTip="Adicionar polilinha" Click="OnPolygon">
                    <Image Source="{StaticResource Icon.Polygon}" Width="18" Height="18" />
                </Button>
                <Rectangle Style="{StaticResource App.ToolSeparator}" />
                <Button Style="{StaticResource App.ToolButton}" ToolTip="Adicionar texto" Click="OnText">
                    <Image Source="{StaticResource Icon.Text}" Width="18" Height="18" />
                </Button>
                <Button Style="{StaticResource App.ToolButton}" ToolTip="Adicionar terminal" Click="OnTerminal">
                    <Image Source="{StaticResource Icon.Conductor}" Width="18" Height="18" />
                </Button>
                <Rectangle Style="{StaticResource App.ToolSeparator}" />
                <Button Style="{StaticResource App.ToolButton}" ToolTip="Excluir selecionado (Del)" Click="OnDelete">
                    <Image Source="{StaticResource Icon.Delete}" Width="18" Height="18" />
                </Button>
                <Button Style="{StaticResource App.ToolButton}" ToolTip="Ajustar conteúdo" Click="OnFit">
                    <Image Source="{StaticResource Icon.Fit}" Width="18" Height="18" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Conteúdo -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="270" />
            </Grid.ColumnDefinitions>

            <controls:ElementEditorCanvas x:Name="Canvas" Grid.Column="0"
                                          Background="{DynamicResource App.Panel.Card}" />

            <!-- Painel de propriedades -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource App.Panel.Background}"
                          BorderBrush="{DynamicResource App.Divider}" BorderThickness="1,0,0,0">
                <StackPanel Margin="12">
                    <TextBlock Text="ELEMENTO" Style="{StaticResource App.SectionHeader}" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Nome" Style="{StaticResource App.FieldLabel}" Margin="0,3,8,3" />
                        <TextBox x:Name="TxtName" Grid.Column="1" Style="{StaticResource App.TextBox}" Margin="0,3"
                                 LostFocus="OnFieldChanged" />
                        <TextBlock Grid.Row="1" Text="Largura" Style="{StaticResource App.FieldLabel}" Margin="0,3,8,3" />
                        <TextBox x:Name="TxtWidth" Grid.Row="1" Grid.Column="1" Style="{StaticResource App.TextBox}" Margin="0,3"
                                 LostFocus="OnFieldChanged" />
                        <TextBlock Grid.Row="2" Text="Altura" Style="{StaticResource App.FieldLabel}" Margin="0,3,8,3" />
                        <TextBox x:Name="TxtHeight" Grid.Row="2" Grid.Column="1" Style="{StaticResource App.TextBox}" Margin="0,3"
                                 LostFocus="OnFieldChanged" />
                        <TextBlock Grid.Row="3" Text="Ponto de âncora X" Style="{StaticResource App.FieldLabel}" Margin="0,3,8,3" />
                        <TextBox x:Name="TxtHotspotX" Grid.Row="3" Grid.Column="1" Style="{StaticResource App.TextBox}" Margin="0,3"
                                 LostFocus="OnFieldChanged" />
                        <TextBlock Grid.Row="4" Text="Ponto de âncora Y" Style="{StaticResource App.FieldLabel}" Margin="0,3,8,3" />
                        <TextBox x:Name="TxtHotspotY" Grid.Row="4" Grid.Column="1" Style="{StaticResource App.TextBox}" Margin="0,3"
                                 LostFocus="OnFieldChanged" />
                        <TextBlock Grid.Row="5" Text="Tipo de vínculo" Style="{StaticResource App.FieldLabel}" Margin="0,3,8,3" />
                        <ComboBox x:Name="CmbLinkType" Grid.Row="5" Grid.Column="1" Style="{StaticResource App.ComboBox}" Margin="0,3"
                                  SelectionChanged="OnFieldChanged" />
                    </Grid>

                    <!-- NOMES MULTI-IDIOMA -->
                    <TextBlock Text="NOMES MULTI-IDIOMA" Style="{StaticResource App.SectionHeader}" Margin="0,16,0,0" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Idioma" Style="{StaticResource App.FieldLabel}" Margin="0,3,8,3" />
                        <TextBox x:Name="TxtLangCode" Grid.Column="1" Style="{StaticResource App.TextBox}" Margin="0,3"
                                 ToolTip="Código do idioma (ex.: pt_BR, en, es, fr)" />
                        <Button Grid.Column="2" Content="+" Width="26" Height="26" Click="OnAddLanguage"
                                ToolTip="Adicionar idioma"
                                Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                                BorderBrush="{DynamicResource App.Border}" Margin="4,0,0,0" />
                        <ListBox x:Name="LstLocalizedNames" Grid.Row="1" Grid.ColumnSpan="3"
                                 Background="{DynamicResource App.Panel.Card}"
                                 BorderBrush="{DynamicResource App.Border}"
                                 Foreground="{DynamicResource App.Text.Primary}"
                                 FontFamily="{StaticResource App.Font}"
                                 Margin="0,6,0,0" Height="120"
                                 SelectionChanged="OnLocalizedNameSelected" />
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal"
                                    HorizontalAlignment="Right" Margin="0,4,0,0">
                            <TextBox x:Name="TxtLocalizedNameValue" Width="180" Style="{StaticResource App.TextBox}" Margin="0,0,6,0"
                                     ToolTip="Nome traduzido" />
                            <Button Content="Definir" Click="OnSetLocalizedName" Width="60" Height="26"
                                    Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                                    BorderBrush="{DynamicResource App.Border}" />
                            <Button Content="Remover" Click="OnRemoveLocalizedName" Width="70" Height="26" Margin="4,0,0,0"
                                    Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                                    BorderBrush="{DynamicResource App.Border}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="TERMINAL SELECIONADO" Style="{StaticResource App.SectionHeader}" Margin="0,16,0,0" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Nome" Style="{StaticResource App.FieldLabel}" Margin="0,3,8,3" />
                        <TextBox x:Name="TxtTermName" Grid.Column="1" Style="{StaticResource App.TextBox}" Margin="0,3"
                                 LostFocus="OnTerminalFieldChanged" />
                        <TextBlock Grid.Row="1" Text="Orientação" Style="{StaticResource App.FieldLabel}" Margin="0,3,8,3" />
                        <ComboBox x:Name="CmbTermOrientation" Grid.Row="1" Grid.Column="1" Style="{StaticResource App.ComboBox}" Margin="0,3"
                                  SelectionChanged="OnTerminalFieldChanged" />
                    </Grid>
                    <TextBlock x:Name="TxtHint" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="10"
                               Foreground="{DynamicResource App.Text.Muted}"
                               Text="Clique para selecionar; arraste para mover; Del exclui; Esc encerra a ferramenta." />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="OK" IsDefault="True" Click="OnOk" Style="{StaticResource App.PrimaryButton}" Width="88" Height="30"
                                Background="{DynamicResource App.Accent}" Foreground="White"
                                FontFamily="{StaticResource App.Font}" BorderThickness="0" />
                        <Button Content="Cancelar" IsCancel="True" Width="88" Height="30" Margin="8,0,0,0"
                                Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                                FontFamily="{StaticResource App.Font}" BorderBrush="{DynamicResource App.Border}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
