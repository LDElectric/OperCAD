<Window x:Class="OperCAD.UI.Views.RotateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rotacionar seleção"
        Width="330" Height="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource App.Background}"
        FontFamily="{StaticResource App.Font}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Rotação fixa:" FontWeight="SemiBold" Margin="0,0,0,6" />

        <!-- 4 rotações fixas: 0°, 90°, 180°, 270° -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
            <Button Content="0&#xB0;" Tag="0" Click="OnFixedAngle" Height="32" Margin="0,0,4,0"
                    Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                    BorderBrush="{DynamicResource App.Border}" FontFamily="{StaticResource App.Font}" />
            <Button Content="90&#xB0;" Tag="90" Click="OnFixedAngle" Height="32" Margin="0,0,4,0"
                    Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                    BorderBrush="{DynamicResource App.Border}" FontFamily="{StaticResource App.Font}" />
            <Button Content="180&#xB0;" Tag="180" Click="OnFixedAngle" Height="32" Margin="0,0,4,0"
                    Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                    BorderBrush="{DynamicResource App.Border}" FontFamily="{StaticResource App.Font}" />
            <Button Content="270&#xB0;" Tag="270" Click="OnFixedAngle" Height="32"
                    Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                    BorderBrush="{DynamicResource App.Border}" FontFamily="{StaticResource App.Font}" />
        </UniformGrid>

        <TextBlock Grid.Row="2" Text="Ângulo personalizado (graus):" Margin="0,0,0,6" />
        <TextBox Grid.Row="3" x:Name="TxtAngle" Style="{StaticResource App.TextBox}" Width="110"
                 HorizontalAlignment="Left" Text="90" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,16,0,0">
            <Button Content="Rotacionar" IsDefault="True" Click="OnOk" Style="{StaticResource App.PrimaryButton}" />
            <Button Content="Cancelar" IsCancel="True" Width="88" Height="30" Margin="8,0,0,0"
                    Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                    FontFamily="{StaticResource App.Font}" BorderBrush="{DynamicResource App.Border}" />
        </StackPanel>
    </Grid>
</Window>
