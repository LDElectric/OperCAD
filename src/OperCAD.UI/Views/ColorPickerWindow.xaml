<Window x:Class="OperCAD.UI.Views.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selecionar Cor" Width="320" Height="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Cores predefinidas:" FontWeight="SemiBold" Margin="0,0,0,6"/>

        <WrapPanel Grid.Row="1" x:Name="PalettePanel" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Hex:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="HexTextBox" Width="100" Text="#000000" VerticalAlignment="Center"
                     TextChanged="OnHexChanged"/>
        </StackPanel>

        <Border Grid.Row="3" x:Name="PreviewBorder" Height="40" Margin="0,0,0,10"
                BorderBrush="Gray" BorderThickness="1"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Margin="0,0,8,0" Click="OnOk" Style="{StaticResource App.PrimaryButton}"/>
            <Button Content="Cancelar" Width="80" Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
