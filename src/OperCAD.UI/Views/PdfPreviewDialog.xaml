<Window x:Class="OperCAD.UI.Views.PdfPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="Prévia da Importação"
        Width="1000" Height="700" MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource App.Background}"
        FontFamily="{StaticResource App.Font}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="TxtTitle" DockPanel.Dock="Left" FontWeight="Bold" FontSize="14"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="TxtInfo" DockPanel.Dock="Right" VerticalAlignment="Center"
                       Foreground="#555555" HorizontalAlignment="Right" />
        </DockPanel>

        <!-- Preview canvas -->
        <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" Background="White">
            <skia:SKElement x:Name="PreviewCanvas"
                            IgnorePixelScaling="True"
                            PaintSurface="OnPaintSurface" />
        </Border>

        <!-- Ações -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Foreground="#555555"
                           FontStyle="Italic" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Width="100" Margin="0,0,8,0" Click="OnCancel" />
                <Button x:Name="BtnManual" Content="Selecionar Manualmente" Width="180"
                        Margin="0,0,8,0" Click="OnManual"
                        ToolTip="Voltar ao diálogo de seleção manual da área útil" />
                <Button x:Name="BtnImport" Content="Importar" Width="120" Click="OnImport"
                        FontWeight="Bold" Background="#2196F3" Foreground="White" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
