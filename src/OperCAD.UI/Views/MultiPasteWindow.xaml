<Window x:Class="OperCAD.UI.Views.MultiPasteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Colagem Múltipla"
        Width="400" Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource App.Background}"
        FontFamily="{StaticResource App.Font}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Colagem Múltipla" Style="{StaticResource App.SectionHeader}"
                   FontSize="15" Foreground="{DynamicResource App.Text.Primary}" Margin="0,0,0,12" />

        <!-- Quantidade de cópias -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Quantas cópias:" Style="{StaticResource App.FieldLabel}" VerticalAlignment="Center" />
            <TextBox x:Name="TxtCopies" Grid.Column="1" Style="{StaticResource App.TextBox}"
                     Text="2" MaxHeight="28" />
        </Grid>

        <!-- Layout -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Layout:" Style="{StaticResource App.FieldLabel}" VerticalAlignment="Center" />
            <ComboBox x:Name="CmbLayout" Grid.Column="1" Width="160" SelectedIndex="0"
                      VerticalAlignment="Center"
                      Style="{StaticResource App.ComboBox}">
                <ComboBoxItem Content="Horizontal" />
                <ComboBoxItem Content="Vertical" />
                <ComboBoxItem Content="Grade" />
            </ComboBox>
        </Grid>

        <!-- Espaçamento -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Espaçamento (mm):" Style="{StaticResource App.FieldLabel}" VerticalAlignment="Center" />
            <TextBox x:Name="TxtSpacing" Grid.Column="1" Style="{StaticResource App.TextBox}"
                     Text="20" MaxHeight="28" />
        </Grid>

        <!-- Área de pré-visualização -->
        <Border Grid.Row="4" Background="#2D2D30" BorderBrush="{DynamicResource App.Border}"
                BorderThickness="1" Margin="0,4,0,0">
            <Canvas x:Name="PreviewCanvas" />
        </Border>

        <!-- Botões -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" IsDefault="True" Click="OnOk" Style="{StaticResource App.PrimaryButton}" Width="80" Height="28"
                    Background="{DynamicResource App.Accent}" Foreground="White"
                    FontFamily="{StaticResource App.Font}" BorderThickness="0" />
            <Button Content="Cancelar" IsCancel="True" Click="OnCancel" Width="80" Height="28" Margin="8,0,0,0"
                    Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                    FontFamily="{StaticResource App.Font}" BorderBrush="{DynamicResource App.Border}" />
        </StackPanel>
    </Grid>
</Window>
