<Window x:Class="OperCAD.UI.Views.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exportar as folhas do projeto"
        Width="720" Height="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App.Background}"
        FontFamily="{StaticResource App.Font}">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Escolha as folhas que deseja exportar e as dimensões de cada uma:"
                       Style="{StaticResource App.FieldValueText}" VerticalAlignment="Center" />
        </StackPanel>

        <ListView x:Name="ListaFolhas" Grid.Row="1" Background="Transparent" BorderThickness="0">
            <ListView.ItemContainerStyle>
                <Style TargetType="{x:Type ListViewItem}">
                    <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Exportar" Width="66">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Título da folha" Width="170" DisplayMemberBinding="{Binding Title}" />
                    <GridViewColumn Header="Nome de arquivo" Width="200">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource App.TextBox}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Largura (px)" Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding WidthPx, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource App.TextBox}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Altura (px)" Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding HeightPx, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource App.TextBox}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Proporção" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding KeepRatio}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Marcar todas" Click="OnCheckAll" Height="26" Padding="10,2"
                    Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                    BorderBrush="{DynamicResource App.Border}" FontFamily="{StaticResource App.Font}" />
            <Button Content="Desmarcar" Click="OnUncheckAll" Height="26" Padding="10,2" Margin="8,0,0,0"
                    Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                    BorderBrush="{DynamicResource App.Border}" FontFamily="{StaticResource App.Font}" />
            <CheckBox x:Name="ChkTerminals" Content="Desenhar terminais" Margin="16,0,0,0" VerticalAlignment="Center"
                      Style="{StaticResource App.CheckBox}" ToolTip="Desenha os pontos de conexão (bornes) dos elementos" />
            <CheckBox x:Name="ChkExportTitleBlock" Content="Desenhar legenda" Margin="16,0,0,0" VerticalAlignment="Center"
                      IsChecked="True"
                      Style="{StaticResource App.CheckBox}" ToolTip="Inclui a legenda na imagem exportada" />
            <TextBlock Text="Formato:" Margin="16,0,6,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource App.Text.Primary}" FontFamily="{StaticResource App.Font}" />
            <ComboBox x:Name="CmbFormat" Width="100" SelectedIndex="0" VerticalAlignment="Center"
                      SelectionChanged="OnFormatChanged"
                      Style="{StaticResource App.ComboBox}">
                <ComboBoxItem Content="PNG" />
                <ComboBoxItem Content="JPG" />
                <ComboBoxItem Content="BMP" />
                <ComboBoxItem Content="SVG" />
            </ComboBox>
        </StackPanel>

        <!-- Opções de renderização SVG -->
        <StackPanel x:Name="SvgOptionsPanel" Grid.Row="2" Orientation="Horizontal" Margin="0,40,0,0"
                    Visibility="Collapsed">
            <CheckBox x:Name="ChkSvgIncludeFrame" Content="Incluir moldura" Margin="16,0,0,0" VerticalAlignment="Center"
                      IsChecked="True"
                      Style="{StaticResource App.CheckBox}" ToolTip="Incluir moldura e cabeçalhos no SVG" />
            <CheckBox x:Name="ChkSvgTransparent" Content="Fundo transparente" Margin="16,0,0,0" VerticalAlignment="Center"
                      Style="{StaticResource App.CheckBox}" ToolTip="Fundo transparente no SVG exportado" />
        </StackPanel>

        <!-- Opções de escala de imagem -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,70,0,0">
            <TextBlock Text="Escala:" Margin="16,0,6,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource App.Text.Primary}" FontFamily="{StaticResource App.Font}" />
            <ComboBox x:Name="CmbScale" Width="120" SelectedIndex="0" VerticalAlignment="Center"
                      Style="{StaticResource App.ComboBox}">
                <ComboBoxItem Content="Original (1:1)" />
                <ComboBoxItem Content="2x (Dobro)" />
                <ComboBoxItem Content="0.5x (Metade)" />
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Copiar p/ área de transferência" Click="OnCopyToClipboard" Height="30" Padding="10,0"
                    Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                    FontFamily="{StaticResource App.Font}" BorderBrush="{DynamicResource App.Border}"
                    ToolTip="Copia a primeira folha marcada como imagem" />
            <Button Content="Exportar" IsDefault="True" Click="OnExport" Width="96" Height="30" Margin="8,0,0,0"
                    Background="{DynamicResource App.Accent}" Foreground="White"
                    FontFamily="{StaticResource App.Font}" BorderThickness="0" />
            <Button Content="Cancelar" IsCancel="True" Width="88" Height="30" Margin="8,0,0,0"
                    Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                    FontFamily="{StaticResource App.Font}" BorderBrush="{DynamicResource App.Border}" />
        </StackPanel>
    </Grid>
</Window>
