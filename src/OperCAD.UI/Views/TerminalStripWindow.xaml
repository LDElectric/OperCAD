<Window x:Class="OperCAD.UI.Views.TerminalStripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Borne (plano de bornes)"
        Width="560" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App.Background}"
        FontFamily="{StaticResource App.Font}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Nome e comentário -->
        <StackPanel>
            <TextBlock Text="BORNE" Style="{StaticResource App.SectionHeader}" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="Nome" Style="{StaticResource App.FieldLabel}" Margin="0,3,8,3" />
                <TextBox x:Name="TxtName" Grid.Column="1" Style="{StaticResource App.TextBox}" Margin="0,3" />
                <TextBlock Grid.Row="1" Text="Comentário" Style="{StaticResource App.FieldLabel}" Margin="0,3,8,3" />
                <TextBox x:Name="TxtComment" Grid.Row="1" Grid.Column="1" Style="{StaticResource App.TextBox}" Margin="0,3" />
            </Grid>
        </StackPanel>

        <!-- Níveis do borne -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="LstLevels" SelectionMode="Extended"
                     Background="{DynamicResource App.Panel.Card}"
                     BorderBrush="{DynamicResource App.Border}"
                     Foreground="{DynamicResource App.Text.Primary}"
                     FontFamily="{StaticResource App.Font}" />
            <StackPanel Grid.Column="1" Margin="8,0,0,0" Width="128">
                <Button Content="Subir" Click="OnMoveUp" Height="28" Margin="0,0,0,6"
                        Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                        FontFamily="{StaticResource App.Font}" BorderBrush="{DynamicResource App.Border}" />
                <Button Content="Descer" Click="OnMoveDown" Height="28" Margin="0,0,0,6"
                        Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                        FontFamily="{StaticResource App.Font}" BorderBrush="{DynamicResource App.Border}" />
                <Button Content="Excluir nível" Click="OnRemoveLevel" Height="28" Margin="0,0,0,12"
                        Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                        FontFamily="{StaticResource App.Font}" BorderBrush="{DynamicResource App.Border}" />
                <ComboBox x:Name="CmbBridgeColor" Height="26" Margin="0,0,0,6" ToolTip="Cor da ponte" />
                <Button Content="Ponte" Click="OnBridge" Height="28" Margin="0,0,0,6"
                        Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                        FontFamily="{StaticResource App.Font}" BorderBrush="{DynamicResource App.Border}" />
                <Button Content="Remover ponte" Click="OnRemoveBridge" Height="28"
                        Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                        FontFamily="{StaticResource App.Font}" BorderBrush="{DynamicResource App.Border}" />
            </StackPanel>
        </Grid>

        <!-- Adicionar terminais livres -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="CmbFreeTerminals" Style="{StaticResource App.ComboBox}"
                      DisplayMemberPath="Label" />
            <Button Grid.Column="1" Content="Novo nível" Click="OnAddLevel" Height="28" Margin="8,0,0,0" Padding="10,0"
                    Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                    FontFamily="{StaticResource App.Font}" BorderBrush="{DynamicResource App.Border}" />
            <Button Grid.Column="2" Content="Ao nível selecionado" Click="OnAddToLevel" Height="28" Margin="8,0,0,0" Padding="10,0"
                    Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                    FontFamily="{StaticResource App.Font}" BorderBrush="{DynamicResource App.Border}" />
        </Grid>

        <!-- OK/Cancelar -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" IsDefault="True" Click="OnOk" Style="{StaticResource App.PrimaryButton}" Width="88" Height="30"
                    Background="{DynamicResource App.Accent}" Foreground="White"
                    FontFamily="{StaticResource App.Font}" BorderThickness="0" />
            <Button Content="Cancelar" IsCancel="True" Width="88" Height="30" Margin="8,0,0,0"
                    Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                    FontFamily="{StaticResource App.Font}" BorderBrush="{DynamicResource App.Border}" />
        </StackPanel>
    </Grid>
</Window>
