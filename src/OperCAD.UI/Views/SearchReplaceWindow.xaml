<Window x:Class="OperCAD.UI.Views.SearchReplaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buscar e Substituir"
        Width="680" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App.Background}"
        FontFamily="{StaticResource App.Font}">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Parâmetros de busca -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock Text="Buscar:" Style="{StaticResource App.FieldLabel}" VerticalAlignment="Center"
                       Margin="0,0,8,6" />
            <TextBox x:Name="TxtSearch" Grid.Column="1" Style="{StaticResource App.TextBox}" Margin="0,0,0,6"
                     AcceptsReturn="False" MaxHeight="28" />

            <TextBlock Grid.Row="1" Text="Modo:" Style="{StaticResource App.FieldLabel}" VerticalAlignment="Center"
                       Margin="0,0,8,6" />
            <ComboBox x:Name="CmbMode" Grid.Column="1" Grid.Row="1" Width="180" SelectedIndex="0"
                      VerticalAlignment="Center" Margin="0,0,0,6"
                      Style="{StaticResource App.ComboBox}">
                <ComboBoxItem Content="Contém" />
                <ComboBoxItem Content="Correspondência exata" />
                <ComboBoxItem Content="Expressão regular" />
            </ComboBox>

            <TextBlock Grid.Row="2" Text="Filtrar:" Style="{StaticResource App.FieldLabel}" VerticalAlignment="Center"
                       Margin="0,0,8,6" />
            <ComboBox x:Name="CmbFilter" Grid.Column="1" Grid.Row="2" Width="180" SelectedIndex="0"
                      VerticalAlignment="Center" Margin="0,0,0,6"
                      Style="{StaticResource App.ComboBox}">
                <ComboBoxItem Content="Todos" />
                <ComboBoxItem Content="Elementos" />
                <ComboBoxItem Content="Condutores" />
                <ComboBoxItem Content="Textos" />
            </ComboBox>

            <CheckBox x:Name="ChkCaseSensitive" Grid.Column="2" Grid.RowSpan="3" Content="Diferenciar maiúsculas"
                      VerticalAlignment="Center" Margin="16,0,0,0"
                      Style="{StaticResource App.CheckBox}" />
        </Grid>

        <!-- Parâmetros de substituição -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Substituir por:" Style="{StaticResource App.FieldLabel}" VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <TextBox x:Name="TxtReplace" Grid.Column="1" Style="{StaticResource App.TextBox}"
                     AcceptsReturn="False" MaxHeight="28" />
        </Grid>

        <!-- Lista de resultados -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TxtResultCount" Grid.Row="0" Margin="0,0,0,4"
                       Style="{StaticResource App.FieldValueText}" />

            <ListView x:Name="ResultList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                      SelectionChanged="OnResultSelected">
                <ListView.ItemContainerStyle>
                    <Style TargetType="{x:Type ListViewItem}">
                        <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Folha" Width="90" DisplayMemberBinding="{Binding PageName}" />
                        <GridViewColumn Header="Objeto" Width="150" DisplayMemberBinding="{Binding ObjectLabel}" />
                        <GridViewColumn Header="Propriedade" Width="100" DisplayMemberBinding="{Binding Property}" />
                        <GridViewColumn Header="Valor" Width="200" DisplayMemberBinding="{Binding Value}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <!-- Botões -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Buscar" Click="OnSearch" Width="80" Height="28"
                    Background="{DynamicResource App.Accent}" Foreground="White"
                    FontFamily="{StaticResource App.Font}" BorderThickness="0" />
            <Button Content="Substituir" Click="OnReplace" Width="88" Height="28" Margin="8,0,0,0"
                    Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                    FontFamily="{StaticResource App.Font}" BorderBrush="{DynamicResource App.Border}" />
            <Button Content="Substituir Todos" Click="OnReplaceAll" Width="110" Height="28" Margin="8,0,0,0"
                    Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                    FontFamily="{StaticResource App.Font}" BorderBrush="{DynamicResource App.Border}" />
            <Button Content="Fechar" IsCancel="True" Click="OnClose" Width="72" Height="28" Margin="8,0,0,0"
                    Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                    FontFamily="{StaticResource App.Font}" BorderBrush="{DynamicResource App.Border}" />
        </StackPanel>
    </Grid>
</Window>
