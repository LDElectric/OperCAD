<Window x:Class="OperCAD.UI.Views.TerminalEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Terminal"
        Width="360" Height="250"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource App.Background}"
        FontFamily="{StaticResource App.Font}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="TERMINAL" Style="{StaticResource App.SectionHeader}" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="Nome" Style="{StaticResource App.FieldLabel}" Margin="0,3,8,3" />
                <TextBox x:Name="TxtName" Grid.Column="1" Style="{StaticResource App.TextBox}" Margin="0,3" Text="1" />
                <TextBlock Grid.Row="1" Text="Orientação" Style="{StaticResource App.FieldLabel}" Margin="0,3,8,3" />
                <ComboBox x:Name="CmbOrientation" Grid.Row="1" Grid.Column="1" Style="{StaticResource App.ComboBox}" Margin="0,3" />
                <TextBlock Grid.Row="2" Text="Tipo" Style="{StaticResource App.FieldLabel}" Margin="0,3,8,3" />
                <ComboBox x:Name="CmbType" Grid.Row="2" Grid.Column="1" Style="{StaticResource App.ComboBox}" Margin="0,3" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" IsDefault="True" Click="OnOk" Style="{StaticResource App.PrimaryButton}" Width="88" Height="30"
                    Background="{DynamicResource App.Accent}" Foreground="White"
                    FontFamily="{StaticResource App.Font}" BorderThickness="0" />
            <Button Content="Cancelar" IsCancel="True" Width="88" Height="30" Margin="8,0,0,0"
                    Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                    FontFamily="{StaticResource App.Font}" BorderBrush="{DynamicResource App.Border}" />
        </StackPanel>
    </Grid>
</Window>
