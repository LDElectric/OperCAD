<Window x:Class="OperCAD.UI.Views.TitleBlockEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editor de legendas (.titleblock)"
        Width="1100" Height="750"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App.Background}"
        FontFamily="{StaticResource App.Font}">

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="Undo" />
        <KeyBinding Key="Y" Modifiers="Control" Command="Redo" />
    </Window.InputBindings>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de ferramentas -->
        <Border Grid.Row="0" Style="{StaticResource App.ToolBar}">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource App.ToolButton}" ToolTip="Selecionar célula" Click="OnSelectTool">
                    <Image Source="{StaticResource Icon.New}" Width="18" Height="18" />
                </Button>
                <Rectangle Style="{StaticResource App.ToolSeparator}" />
                <Button x:Name="BtnUndo" Style="{StaticResource App.ToolButton}" ToolTip="Desfazer (Ctrl+Z)" Click="OnUndo">
                    <Image Source="{StaticResource Icon.Undo}" Width="18" Height="18" />
                </Button>
                <Button x:Name="BtnRedo" Style="{StaticResource App.ToolButton}" ToolTip="Refazer (Ctrl+Y)" Click="OnRedo">
                    <Image Source="{StaticResource Icon.Redo}" Width="18" Height="18" />
                </Button>
                <Rectangle Style="{StaticResource App.ToolSeparator}" />
                <Button Style="{StaticResource App.ToolButton}" ToolTip="Mesclar células selecionadas" Click="OnMergeCells">
                    <Image Source="{StaticResource Icon.Save}" Width="18" Height="18" />
                </Button>
                <Button Style="{StaticResource App.ToolButton}" ToolTip="Dividir célula mesclada" Click="OnSplitCell">
                    <Image Source="{StaticResource Icon.Delete}" Width="18" Height="18" />
                </Button>
                <Rectangle Style="{StaticResource App.ToolSeparator}" />
                <Button Style="{StaticResource App.ToolButton}" ToolTip="Inserir logo na célula" Click="OnInsertLogo">
                    <Image Source="{StaticResource Icon.Open}" Width="18" Height="18" />
                </Button>
                <Button Style="{StaticResource App.ToolButton}" ToolTip="Remover logo da célula" Click="OnRemoveLogo">
                    <Image Source="{StaticResource Icon.Delete}" Width="18" Height="18" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Metadados e grade -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="TEMPLATE" Style="{StaticResource App.SectionHeader}" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Nome" Style="{StaticResource App.FieldLabel}" Margin="0,3,8,3" />
                    <TextBox x:Name="TxtName" Grid.Column="1" Style="{StaticResource App.TextBox}" Margin="0,3" />
                    <TextBlock Grid.Row="1" Text="Informação" Style="{StaticResource App.FieldLabel}" Margin="0,3,8,3" />
                    <TextBox x:Name="TxtInformation" Grid.Row="1" Grid.Column="1" Style="{StaticResource App.TextBox}" Margin="0,3" />
                </Grid>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="GRADE (dimensões)" Style="{StaticResource App.SectionHeader}" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Colunas" Style="{StaticResource App.FieldLabel}" Margin="0,3,8,3" />
                    <TextBox x:Name="TxtCols" Grid.Column="1" Style="{StaticResource App.TextBox}" Margin="0,3"
                             ToolTip="Ex.: t6%;t4%;r100%;50px;" />
                    <TextBlock Grid.Row="1" Text="Linhas (alturas)" Style="{StaticResource App.FieldLabel}" Margin="0,3,8,3" />
                    <TextBox x:Name="TxtRows" Grid.Row="1" Grid.Column="1" Style="{StaticResource App.TextBox}" Margin="0,3"
                             ToolTip="Ex.: 10;10;10;" />
                    <Button Grid.Row="2" Grid.Column="1" Content="Aplicar grade" Click="OnApplyGrid" Height="26"
                            HorizontalAlignment="Left" Padding="10,0" Margin="0,6,0,0"
                            Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                            BorderBrush="{DynamicResource App.Border}" />
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Área principal: Canvas + Lista de células + Propriedades -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- Canvas de visualização da legenda -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="180" />
                </Grid.RowDefinitions>

                <Border Background="White" BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                        Grid.Row="0" Margin="0,0,0,8">
                    <Canvas x:Name="TitleBlockCanvas" ClipToBounds="True" Background="White" />
                </Border>

                <!-- Lista de células -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ListView x:Name="LstCells" Background="{DynamicResource App.Panel.Card}"
                              BorderBrush="{DynamicResource App.Border}"
                              Foreground="{DynamicResource App.Text.Primary}"
                              FontFamily="{StaticResource App.Font}"
                              SelectionChanged="OnCellSelectionChanged"
                              MouseDoubleClick="OnEditCell">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Linha" Width="50" DisplayMemberBinding="{Binding Row}" />
                                <GridViewColumn Header="Col" Width="50" DisplayMemberBinding="{Binding Col}" />
                                <GridViewColumn Header="Extensão" Width="60" DisplayMemberBinding="{Binding CellSpanDisplay}" />
                                <GridViewColumn Header="Campo" Width="110" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Valor" Width="150" DisplayMemberBinding="{Binding Value}" />
                                <GridViewColumn Header="Rótulo" Width="170" DisplayMemberBinding="{Binding Label}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0" Width="128">
                        <Button Content="Adicionar célula..." Click="OnAddCell" Height="28" Margin="0,0,0,6"
                                Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                                BorderBrush="{DynamicResource App.Border}" />
                        <Button Content="Editar célula..." Click="OnEditCell" Height="28" Margin="0,0,0,6"
                                Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                                BorderBrush="{DynamicResource App.Border}" />
                        <Button Content="Excluir célula" Click="OnRemoveCell" Height="28"
                                Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                                BorderBrush="{DynamicResource App.Border}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Painel de propriedades da célula selecionada -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource App.Panel.Background}"
                          BorderBrush="{DynamicResource App.Divider}" BorderThickness="1,0,0,0">
                <StackPanel Margin="12">
                    <TextBlock Text="CÉLULA SELECIONADA" Style="{StaticResource App.SectionHeader}" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Campo" Style="{StaticResource App.FieldLabel}" Margin="0,3,8,3" />
                        <TextBox x:Name="TxtPropName" Grid.Column="1" Style="{StaticResource App.TextBox}" Margin="0,3"
                                 LostFocus="OnPropertyChanged" />
                        <TextBlock Grid.Row="1" Text="Valor" Style="{StaticResource App.FieldLabel}" Margin="0,3,8,3" />
                        <TextBox x:Name="TxtPropValue" Grid.Row="1" Grid.Column="1" Style="{StaticResource App.TextBox}" Margin="0,3"
                                 LostFocus="OnPropertyChanged" />
                        <TextBlock Grid.Row="2" Text="Rótulo" Style="{StaticResource App.FieldLabel}" Margin="0,3,8,3" />
                        <TextBox x:Name="TxtPropLabel" Grid.Row="2" Grid.Column="1" Style="{StaticResource App.TextBox}" Margin="0,3"
                                 LostFocus="OnPropertyChanged" />
                        <TextBlock Grid.Row="3" Text="Tamanho fonte" Style="{StaticResource App.FieldLabel}" Margin="0,3,8,3" />
                        <TextBox x:Name="TxtPropFontSize" Grid.Row="3" Grid.Column="1" Style="{StaticResource App.TextBox}" Margin="0,3"
                                 LostFocus="OnPropertyChanged" />
                        <TextBlock Grid.Row="4" Text="Alinhamento" Style="{StaticResource App.FieldLabel}" Margin="0,3,8,3" />
                        <ComboBox x:Name="CmbPropAlign" Grid.Row="4" Grid.Column="1" Style="{StaticResource App.ComboBox}" Margin="0,3"
                                  SelectionChanged="OnPropertyChanged" />
                        <TextBlock Grid.Row="5" Text="Alinh. vertical" Style="{StaticResource App.FieldLabel}" Margin="0,3,8,3" />
                        <ComboBox x:Name="CmbPropValign" Grid.Row="5" Grid.Column="1" Style="{StaticResource App.ComboBox}" Margin="0,3"
                                  SelectionChanged="OnPropertyChanged" />
                        <CheckBox x:Name="ChkPropDisplayLabel" Grid.Row="6" Grid.Column="1" Content="Exibir rótulo"
                                  Style="{StaticResource App.CheckBox}" Margin="0,4"
                                  Checked="OnPropertyChanged" Unchecked="OnPropertyChanged" />
                        <CheckBox x:Name="ChkPropHadjust" Grid.Row="7" Grid.Column="1" Content="Ajustar fonte"
                                  Style="{StaticResource App.CheckBox}" Margin="0,4"
                                  Checked="OnPropertyChanged" Unchecked="OnPropertyChanged" />
                        <TextBlock Grid.Row="8" Text="Logo" Style="{StaticResource App.FieldLabel}" Margin="0,3,8,3" />
                        <TextBlock Grid.Row="8" Grid.Column="1" x:Name="TxtLogoStatus" Text="Nenhum"
                                  Style="{StaticResource App.FieldLabel}" Margin="0,3" Foreground="{DynamicResource App.Text.Muted}" />
                    </Grid>

                    <TextBlock Text="LOGO" Style="{StaticResource App.SectionHeader}" Margin="0,16,0,0" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Posição X" Style="{StaticResource App.FieldLabel}" Margin="0,3,8,3" />
                        <TextBox x:Name="TxtLogoX" Grid.Column="1" Style="{StaticResource App.TextBox}" Margin="0,3"
                                 LostFocus="OnLogoPropertyChanged" />
                        <TextBlock Grid.Row="1" Text="Posição Y" Style="{StaticResource App.FieldLabel}" Margin="0,3,8,3" />
                        <TextBox x:Name="TxtLogoY" Grid.Row="1" Grid.Column="1" Style="{StaticResource App.TextBox}" Margin="0,3"
                                 LostFocus="OnLogoPropertyChanged" />
                        <TextBlock Grid.Row="2" Text="Largura" Style="{StaticResource App.FieldLabel}" Margin="0,3,8,3" />
                        <TextBox x:Name="TxtLogoWidth" Grid.Row="2" Grid.Column="1" Style="{StaticResource App.TextBox}" Margin="0,3"
                                 LostFocus="OnLogoPropertyChanged" />
                        <TextBlock Grid.Row="3" Text="Altura" Style="{StaticResource App.FieldLabel}" Margin="0,3,8,3" />
                        <TextBox x:Name="TxtLogoHeight" Grid.Row="3" Grid.Column="1" Style="{StaticResource App.TextBox}" Margin="0,3"
                                 LostFocus="OnLogoPropertyChanged" />
                        <TextBlock Grid.Row="4" Text="Arquivo" Style="{StaticResource App.FieldLabel}" Margin="0,3,8,3" />
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtLogoFileName" Text=""
                                   Style="{StaticResource App.FieldLabel}" Margin="0,3" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.Text.Muted}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Botões -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Salvar" Click="OnSave" Width="88" Height="30"
                    Background="{DynamicResource App.Accent}" Foreground="White"
                    FontFamily="{StaticResource App.Font}" BorderThickness="0" />
            <Button Content="Salvar como..." Click="OnSaveAs" Width="110" Height="30" Margin="8,0,0,0"
                    Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                    FontFamily="{StaticResource App.Font}" BorderBrush="{DynamicResource App.Border}" />
            <Button Content="Fechar" IsCancel="True" Width="88" Height="30" Margin="8,0,0,0"
                    Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                    FontFamily="{StaticResource App.Font}" BorderBrush="{DynamicResource App.Border}" />
        </StackPanel>
    </Grid>
</Window>
