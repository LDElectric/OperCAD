<Window x:Class="OperCAD.UI.Views.NewProjectNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novo projeto"
        Width="380" Height="160"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource App.Background}"
        FontFamily="{StaticResource App.Font}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Nome do projeto:" Style="{StaticResource App.FieldLabel}" Margin="0,0,0,6" />

        <TextBox x:Name="TxtProjectName" Grid.Row="1" Style="{StaticResource App.TextBox}"
                 MinHeight="28" VerticalContentAlignment="Center"
                 MaxLength="200" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" IsDefault="True" Click="OnOk"
                    Style="{StaticResource App.PrimaryButton}" Width="88" Height="28" />
            <Button Content="Cancelar" IsCancel="True" Width="88" Height="28" Margin="8,0,0,0"
                    Background="{DynamicResource App.Panel.Card}" Foreground="{DynamicResource App.Text.Primary}"
                    BorderBrush="{DynamicResource App.Border}" />
        </StackPanel>
    </Grid>
</Window>
