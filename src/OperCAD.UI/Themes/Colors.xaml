<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta clara com cores neutras para a interface do OperCAD. -->
    <Color x:Key="App.BackgroundColor">#EFEFEF</Color>
    <Color x:Key="App.PanelColor">#F0F0F0</Color>
    <Color x:Key="App.PanelHeaderColor">#E3E3E3</Color>
    <Color x:Key="App.CardColor">#FFFFFF</Color>
    <Color x:Key="App.HoverColor">#D6E4F5</Color>
    <Color x:Key="App.BorderColor">#A6A6A6</Color>
    <Color x:Key="App.DividerColor">#C9C9C9</Color>
    <Color x:Key="App.TextPrimaryColor">#1A1A1A</Color>
    <Color x:Key="App.TextSecondaryColor">#4D4D4D</Color>
    <Color x:Key="App.TextMutedColor">#6E6E6E</Color>
    <Color x:Key="App.AccentColor">#3DAEE9</Color>
    <Color x:Key="App.AccentSoftColor">#B8D8F0</Color>
    <Color x:Key="App.AccentBorderColor">#2D7EB5</Color>

    <SolidColorBrush x:Key="App.Background" Color="{StaticResource App.BackgroundColor}" />
    <SolidColorBrush x:Key="App.Panel.Background" Color="{StaticResource App.PanelColor}" />
    <SolidColorBrush x:Key="App.Panel.Header" Color="{StaticResource App.PanelHeaderColor}" />
    <SolidColorBrush x:Key="App.Panel.Card" Color="{StaticResource App.CardColor}" />
    <SolidColorBrush x:Key="App.Hover" Color="{StaticResource App.HoverColor}" />
    <SolidColorBrush x:Key="App.Border" Color="{StaticResource App.BorderColor}" />
    <SolidColorBrush x:Key="App.Divider" Color="{StaticResource App.DividerColor}" />
    <SolidColorBrush x:Key="App.Text.Primary" Color="{StaticResource App.TextPrimaryColor}" />
    <SolidColorBrush x:Key="App.Text.Secondary" Color="{StaticResource App.TextSecondaryColor}" />
    <SolidColorBrush x:Key="App.Text.Muted" Color="{StaticResource App.TextMutedColor}" />
    <SolidColorBrush x:Key="App.Accent" Color="{StaticResource App.AccentColor}" />
    <SolidColorBrush x:Key="App.Accent.Hover" Color="#FF2D9CDB" />
    <SolidColorBrush x:Key="App.Accent.Soft" Color="{StaticResource App.AccentSoftColor}" />
    <SolidColorBrush x:Key="App.Accent.Border" Color="{StaticResource App.AccentBorderColor}" />

    <!-- Cor dos ícones da barra de ferramentas (monocromático flat, theme-able) -->
    <SolidColorBrush x:Key="App.Icon.Foreground" Color="{StaticResource App.TextPrimaryColor}" />

    <FontFamily x:Key="App.Font">Segoe UI</FontFamily>

</ResourceDictionary>
