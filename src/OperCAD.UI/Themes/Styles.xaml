<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Menu -->
    <Style x:Key="App.MenuBar" TargetType="{x:Type Menu}">
        <Setter Property="Background" Value="{DynamicResource App.Panel.Header}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}" />
        <Setter Property="FontFamily" Value="{StaticResource App.Font}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- MenuItem – estilo sem colunas, apenas texto, com check sutil -->
    <Style x:Key="App.MenuItem" TargetType="{x:Type MenuItem}">
        <Setter Property="FontFamily" Value="{StaticResource App.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="Transparent"
                                Padding="24,5,24,5"
                                SnapsToDevicePixels="True">
                            <Grid x:Name="RootGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="CheckCol" Width="Auto" SharedSizeGroup="MenuItemIcon" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Indicador de seleção (check) -->
                                <TextBlock x:Name="CheckMark"
                                           Grid.Column="0"
                                           Text="&#x2713;"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource App.Accent}"
                                           Visibility="Collapsed"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,6,0" />

                                <!-- Texto do item -->
                                <ContentPresenter x:Name="HeaderPresenter"
                                                  Grid.Column="1"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />

                                <!-- Seta de submenu -->
                                <Path x:Name="Arrow"
                                      Grid.Column="2"
                                      Data="M 0 0 L 4 4 L 0 8 Z"
                                      Fill="{DynamicResource App.Text.Muted}"
                                      Width="6" Height="8"
                                      VerticalAlignment="Center"
                                      Margin="12,0,0,0"
                                      Visibility="Collapsed"
                                      Stretch="Uniform" />
                            </Grid>
                        </Border>
                        <!-- Itens do submenu -->
                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsSubmenuOpen}"
                               Placement="Right"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide"
                               VerticalOffset="-2">
                            <Border x:Name="SubmenuBorder"
                                    Background="{DynamicResource App.Panel.Card}"
                                    BorderBrush="{DynamicResource App.Divider}"
                                    BorderThickness="1"
                                    Padding="0,4">
                                <ItemsPresenter />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- TopLevelItem (menu bar): sem coluna de check, padding compacto, sem seta -->
                        <DataTrigger Binding="{Binding Role, RelativeSource={RelativeSource Self}}" Value="TopLevelItem">
                            <Setter TargetName="CheckCol" Property="Width" Value="0" />
                            <Setter TargetName="Bd" Property="Padding" Value="8,5" />
                            <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom" />
                            <Setter TargetName="PART_Popup" Property="VerticalOffset" Value="0" />
                        </DataTrigger>
                        <!-- TopLevelHeader (menu bar com submenu): sem check, padding compacto, sem seta -->
                        <DataTrigger Binding="{Binding Role, RelativeSource={RelativeSource Self}}" Value="TopLevelHeader">
                            <Setter TargetName="CheckCol" Property="Width" Value="0" />
                            <Setter TargetName="Bd" Property="Padding" Value="8,5" />
                            <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom" />
                            <Setter TargetName="PART_Popup" Property="VerticalOffset" Value="0" />
                        </DataTrigger>
                        <!-- SubmenuHeader: seta visível -->
                        <DataTrigger Binding="{Binding Role, RelativeSource={RelativeSource Self}}" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <!-- Separador: linha horizontal -->
                        <DataTrigger Binding="{Binding Role, RelativeSource={RelativeSource Self}}" Value="Separator">
                            <Setter TargetName="RootGrid" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Bd" Property="Height" Value="1" />
                            <Setter TargetName="Bd" Property="Padding" Value="0" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Divider}" />
                        </DataTrigger>
                        <!-- Mostra check quando marcado -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Hover}" />
                        </Trigger>
                        <!-- Desabilitado -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                        <!-- Submenu aberto: fundo no item pai -->
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Estilo implícito: aplica o template limpo a TODOS os MenuItem da aplicação
         (barra de menus, submenus e menus de contexto) — sem colunas de ícone/atalho -->
    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource App.MenuItem}" />

    <!-- Barra de ferramentas -->
    <Style x:Key="App.ToolBar" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource App.Panel.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Divider}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="6,3" />
    </Style>

    <Style x:Key="App.ToolButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Accent.Soft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="App.ToolSeparator" TargetType="{x:Type Rectangle}">
        <Setter Property="Fill" Value="{DynamicResource App.Divider}" />
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="6,3" />
        <Setter Property="Height" Value="22" />
    </Style>

    <!-- Botão de ferramenta alternável (grid, snap, ferramentas ativas) -->
    <Style x:Key="App.ToolButtonToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Accent.Soft}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Accent.Soft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botão primário (ação principal dos diálogos: OK / Rotacionar).
         Fundo accent + texto branco em negrito → contraste alto em todos os diálogos. -->
    <Style x:Key="App.PrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource App.Accent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource App.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource App.Accent.Border}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Accent.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Accent.Border}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cabeçalho de painel -->
    <Style x:Key="App.Panel.HeaderBorder" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource App.Panel.Header}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Divider}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="10,7" />
    </Style>
    <Style x:Key="App.Panel.HeaderText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource App.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}" />
    </Style>

    <!-- Barra de status -->
    <Style x:Key="App.StatusBar" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource App.Panel.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Divider}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="8,3" />
    </Style>

    <!-- Título de seção (propriedades) -->
    <Style x:Key="App.SectionHeader" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource App.Font}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text.Muted}" />
    </Style>

    <!-- Etiqueta de campo -->
    <Style x:Key="App.FieldLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource App.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text.Muted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Valor de campo (texto) -->
    <Style x:Key="App.FieldValueText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource App.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Caixa de texto escura -->
    <Style x:Key="App.TextBox" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource App.Panel.Card}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource App.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource App.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Caixa de texto compacta (para campos de legenda) -->
    <Style x:Key="App.TextBox.Compact" TargetType="{x:Type TextBox}" BasedOn="{StaticResource App.TextBox}">
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="MinHeight" Value="24" />
    </Style>

    <!-- ComboBox escura -->
    <Style x:Key="App.ComboBox" TargetType="{x:Type ComboBox}">
        <Setter Property="Background" Value="{DynamicResource App.Panel.Card}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource App.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- CheckBox escura -->
    <Style x:Key="App.CheckBox" TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}" />
        <Setter Property="FontFamily" Value="{StaticResource App.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- TreeViewItem – aparência de árvore com setas, indentação e seleção -->
    <Style x:Key="App.TreeViewItem" TargetType="{x:Type TreeViewItem}">
        <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}" />
        <Setter Property="FontFamily" Value="{StaticResource App.Font}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="2,1" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeViewItem}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Indentação + seta expand/collapse -->
                        <ToggleButton x:Name="Expander"
                                      Grid.Column="0" Grid.Row="0"
                                      IsChecked="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsExpanded}"
                                      Width="16" Height="16"
                                      Cursor="Hand" Focusable="False"
                                      Background="Transparent" BorderThickness="0">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Grid Background="Transparent">
                                        <Path x:Name="ExpandPath"
                                              Width="8" Height="8"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Stretch="Uniform"
                                              Data="M 0 0 L 4 4 L 0 8 Z"
                                              Fill="{DynamicResource App.Text.Muted}" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ExpandPath" Property="Fill" Value="{DynamicResource App.Text.Primary}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ExpandPath" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="90" CenterX="4" CenterY="4" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- Conteúdo do nó -->
                        <ContentPresenter x:Name="PART_Header"
                                          Grid.Column="1" Grid.Row="0"
                                          ContentSource="Header"
                                          VerticalAlignment="Center"
                                          Margin="2,0,0,0" />

                        <!-- Filhos (sub-árvore): ocupa toda a largura para manter o alinhamento à esquerda -->
                        <ItemsPresenter x:Name="ItemsHost"
                                        Grid.Row="1" Grid.ColumnSpan="2"
                                        Margin="0" />

                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Esconde a seta quando não há filhos -->
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!-- COLAPSAR: oculta os filhos quando o nó está recolhido -->
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource App.Hover}" />
                        </Trigger>
                        <!-- Seleção -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource App.Accent.Soft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TabItem para painéis (minimalista) -->
    <Style x:Key="App.PanelTabItem" TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{DynamicResource App.Text.Secondary}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource App.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="Bd" Background="Transparent"
                            BorderThickness="0,0,0,2" BorderBrush="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ScrollBar fino para Viewers -->
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource App.Divider}" />
        <Setter Property="Width" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid x:Name="Bg" Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border Background="{DynamicResource App.Divider}" CornerRadius="3" Margin="1" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="8" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
