<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==========================================================
         ÍCONES VETORIAIS DO OperCAD — estilo monocromático flat
         ==========================================================
         - Todos os ícones desenhados à mão (PathGeometry) em grade 24x24.
         - Traço único na cor App.Icon.Foreground (theme-able via DynamicResource).
         - Nenhum PNG / nenhuma herança visual externa.
         - Pontos e nós usam preenchimento na cor do traço (flat).
         ========================================================== -->

    <Pen x:Key="Icon.Pen" Brush="{DynamicResource App.Icon.Foreground}" Thickness="1.6"
         StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
    <Pen x:Key="Icon.Pen.Thin" Brush="{DynamicResource App.Icon.Foreground}" Thickness="1.1"
         StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />

    <!-- ==================== ARQUIVO ==================== -->

    <!-- Novo projeto: folha com canto dobrado + sinal de mais -->
    <DrawingImage x:Key="Icon.New">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{x:Null}" Pen="{StaticResource Icon.Pen}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M7,3 H15 L19,7 V21 H7 Z M15,3 V7 H19" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{x:Null}" Pen="{StaticResource Icon.Pen}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M11,12 V17 M8.5,14.5 H13.5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Abrir projeto: pasta -->
    <DrawingImage x:Key="Icon.Open">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{x:Null}" Pen="{StaticResource Icon.Pen}">
                    <GeometryDrawing.Geometry>
