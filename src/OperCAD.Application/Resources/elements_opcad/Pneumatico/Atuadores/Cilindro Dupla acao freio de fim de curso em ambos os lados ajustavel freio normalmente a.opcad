{
  "version": "1.0",
  "source": "opcad",
  "sourceFile": "Dupla_acao_freio_de_fim_de_curso_em_ambos_os_lados_ajustavel_freio_normalmente_a.opcad",
  "id": "{0c39bd4b-77dd-2ee8-e937-e975c3ba0365}",
  "names": {
    "ar": "مزدوج الفعل + فرامل نهاية الشوط على كلا الجانبين + قابل للتعديل + الفرامل مفتوحة عادة",
    "cs": "Dvojčinná + brzda konce zdvihu na obou stranách + nastavitelná + brzda normálně otevřená",
    "da": "Dobbeltvirkende + afslutningsbremse på begge sider + justerbar + bremse normalt åben",
    "de": "Doppeltwirkend + Endlagenbremse beidseitig + einstellbar + Bremse normal offen",
    "el": "Διπλής δράσης + φρένο στο τέλος της διαδρομής και στις δύο πλευρές + ρυθμιζόμενο + φρένο κανονικά ανοιχτό",
    "en": "Double-acting + end-of-stroke brake on both sides + adjustable + brake normally open",
    "es": "Doble efecto + freno de final de carrera en ambos lados + ajustable + freno normalmente abierto",
    "fr": "Double effet + frein de fin de course des deux côtés + réglable + frein normalement ouvert",
    "hr": "Dvostrano djelovanje + kočnica na kraju hoda s obje strane + podesiva + kočnica normalno otvorena",
    "hu": "Kettős működésű + löketvégi fék mindkét oldalon + állítható + fék alaphelyzetben nyitva",
    "it": "Doppio effetto + freno di fine corsa su entrambi i lati + regolabile + freno normalmente aperto",
    "ja": "複動式+両側のストローク終了ブレーキ+調整可能+ブレーキは通常開",
    "mn": "Хоёр талдаа давхар үйлдэлтэй + цус харвалтын төгсгөлийн тоормос + тохируулгатай + тоормос ердийн үед нээлттэй",
    "nb": "Dobbeltvirkende + sluttbrems på begge sider + justerbar + brems normalt åpen",
    "nl": "Dubbelwerkend + eindeslagrem aan beide zijden + verstelbaar + rem normaal open",
    "pl": "Dwustronnego działania + hamulec krańcowy po obu stronach + regulowany + hamulec normalnie otwarty",
    "pt": "Cilindro Dupla acao freio de fim de curso em ambos os lados ajustavel freio normalmente a",
    "pt_BR": "Dupla ação + freio de fim de curso em ambos os lados + ajustável + freio normalmente aberto",
    "ro": "Dublă acțiune + frână de capăt de cursă pe ambele părți + reglabilă + frână normal deschisă",
    "ru": "Двустороннего действия + тормоз в конце хода с обеих сторон + регулируемый + нормально открытый тормоз",
    "sl": "Dvostransko delujoča + zavora na koncu hoda na obeh straneh + nastavljiva + normalno odprta zavora",
    "sr": "Двострано дејство + кочница на крају хода са обе стране + подесива + кочница нормално отворена",
    "tr": "Çift etkili + her iki tarafta strok sonu freni + ayarlanabilir + fren normalde açık"
  },
