  "names": {
    "ar": "مزدوج الفعل + فرامل نهاية الشوط على جانب واحد + قابل للتعديل + مغناطيس",
    "cs": "Dvojčinná + brzda konce zdvihu na jedné straně + nastavitelná + magnet",
    "da": "Dobbeltvirkende + afslutningsbremse på den ene side + justerbar + magnet",
    "de": "Doppeltwirkend + Endlagenbremse einseitig + einstellbar + Magnet",
    "el": "Διπλής δράσης + φρένο στο τέλος της διαδρομής στη μία πλευρά + ρυθμιζόμενο + μαγνήτης",
    "en": "Double-acting + end-of-stroke brake on one side + adjustable + magnet",
    "es": "Doble efecto + freno de final de carrera en un lado + ajustable + imán",
    "fr": "Double effet + frein de fin de course unilatéral + réglable + aimant",
    "hr": "Dvostruko djelovanje + kočnica na kraju hoda s jedne strane + podesiva + magnet",
    "hu": "Kettős működésű + löketvégi fék az egyik oldalon + állítható + mágnes",
    "it": "Doppio effetto + freno di fine corsa su un lato + regolabile + magnete",
    "ja": "複動式+片側のストロークエンドブレーキ+調整可能+マグネット",
    "mn": "Давхар үйлдэлтэй + нэг талдаа харвалтын төгсгөлийн тоормос + тохируулгатай + соронз",
    "nb": "Dobbeltvirkende + sluttbrems på den ene siden + justerbar + magnet",
    "nl": "Dubbelwerkend + eindeslagrem eenzijdig + verstelbaar + magneet",
    "pl": "Dwustronnego działania + hamulec krańcowy z jednej strony + regulowany + magnes",
    "pt": "Cilindro Dupla acao freio de fim de curso de um lado ajustavel ima",
    "pt_BR": "Dupla ação + freio de fim de curso de um lado + ajustável + ímã",
    "ro": "Dubla actiune + frana de final de cursa pe o parte + reglabila + magnet",
    "ru": "Двустороннего действия + односторонний тормоз в конце хода + регулируемый + магнит",
    "sl": "Dvosmerna + zavora na koncu hoda na eni strani + nastavljiva + magnet",
    "sr": "Двоструко дејство + кочница на крају хода на једној страни + подесива + магнет",
    "tr": "Bir tarafta çift etkili + strok sonu freni + ayarlanabilir + mıknatıs"
  },
