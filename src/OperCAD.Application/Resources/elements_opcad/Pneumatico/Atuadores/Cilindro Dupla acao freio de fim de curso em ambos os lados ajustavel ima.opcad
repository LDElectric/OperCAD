  "sourceFile": "Dupla_acao_freio_de_fim_de_curso_em_ambos_os_lados_ajustavel_ima.opcad",
  "id": "{b028b305-16bb-b28c-b3a5-633e4ed79d1e}",
  "names": {
    "ar": "مزدوج الفعل + فرامل نهاية السفر على كلا الجانبين + قابل للتعديل + مغناطيس",
    "cs": "Dvojčinná + dojezdová brzda na obou stranách + nastavitelná + magnet",
    "da": "Dobbeltvirkende + endebremse på begge sider + justerbar + magnet",
    "de": "Doppeltwirkend + Endlagenbremse beidseitig + einstellbar+ Magnet",
    "el": "Διπλής δράσης + φρένο τέλους διαδρομής και στις δύο πλευρές + ρυθμιζόμενο + μαγνήτης",
    "en": "Double-acting + end-of-travel brake on both sides + adjustable + magnet",
    "es": "Doble efecto + freno de final de carrera en ambos lados + regulable + magnético",
    "fr": "Double effet + frein de fin de course des deux côtés + réglable + aimant",
    "hr": "Dvostrano djelovanje + kočnica za kraj vožnje s obje strane + podesiva + magnet",
    "hu": "Kettős működésű + végfék mindkét oldalon + állítható + mágnes",
    "it": "Doppio effetto + freno di fine corsa su entrambi i lati + regolabile + magnete",
    "ja": "複動式+両側の走行終了ブレーキ+調整可能+マグネット",
    "mn": "Хоёр талдаа давхар үйлдэлтэй + аяллын төгсгөлийн тоормос + тохируулгатай + соронз",
    "nb": "Dobbeltvirkende + endebrems på begge sider + justerbar + magnet",
    "nl": "Dubbelwerkend + eindelooprem aan beide zijden + verstelbaar + magneet",
    "pl": "Dwustronnego działania + hamulec krańcowy po obu stronach + regulowany + magnes",
    "pt": "Cilindro Dupla acao freio de fim de curso em ambos os lados ajustavel ima",
    "pt_BR": "Dupla ação + freio de fim de curso em ambos os lados + ajustável + ímã",
    "ro": "Frână cu dublă acțiune + capăt de cursă pe ambele părți + reglabilă + magnet",
    "ru": "Двустороннего действия + концевой тормоз с обеих сторон + регулируемый + магнит",
    "sl": "Dvostransko delovanje + zavora na koncu vožnje na obeh straneh + nastavljiva + magnet",
    "sr": "Двострано дејство + кочница за крај вожње са обе стране + подесива + магнет",
    "tr": "Çift etkili + her iki tarafta hareket sonu freni + ayarlanabilir + mıknatıs"
  },
