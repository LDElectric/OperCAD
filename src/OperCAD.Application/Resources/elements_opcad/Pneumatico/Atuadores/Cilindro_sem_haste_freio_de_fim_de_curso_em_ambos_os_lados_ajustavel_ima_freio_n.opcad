{
  "version": "1.0",
  "source": "opcad",
  "sourceFile": "Cilindro_sem_haste_freio_de_fim_de_curso_em_ambos_os_lados_ajustavel_ima_freio_n.opcad",
  "id": "{f16b52b9-39d7-3916-caeb-66e63ff0fd3b}",
  "names": {
    "ar": "أسطوانة بدون رود + فرامل نهاية الشوط على كلا الجانبين + قابل للتعديل + مغناطيس + فرامل مغلقة بشكل طبيعي",
    "ca": "Cilindre sense vara + fre de final de carrera per ambdós costats + ajustable + imant + fre normalment tancat",
    "cs": "Bezpístnicový válec + brzda konce zdvihu na obou stranách + nastavitelná + magnet + brzda normálně zavřená",
    "da": "Stangløs cylinder + endeslagsbremse på begge sider + justerbar + magnet + bremse normalt lukket",
    "de": "Kolbenstangenloser Zylinder + Endlagenbremse beidseitig + einstellbar + Magnet + Bremse normal geschlossen",
    "el": "Κύλινδρος χωρίς ράβδους + φρένο στο τέλος της διαδρομής και στις δύο πλευρές + ρυθμιζόμενο + μαγνήτης + φρένο κανονικά κλειστό",
    "en": "Rodless cylinder + end-of-stroke brake on both sides + adjustable + magnet + brake normally closed",
    "es": "Cilindro sin vástago + freno de final de carrera en ambos lados + regulable + imán + freno normalmente cerrado",
    "fr": "Vérin sans tige + frein de fin de course des deux côtés + réglable + aimant + frein normalement fermé",
    "hr": "Cilindar bez šipke + kočnica na kraju hoda s obje strane + podesiva + magnet + kočnica normalno zatvorena",
    "hu": "Rúd nélküli henger + löketvégi fék mindkét oldalon + állítható + mágnes + fék alaphelyzetben zárva",
    "it": "Cilindro senza stelo + freno di fine corsa su entrambi i lati + registrabile + magnete + freno normalmente chiuso",
    "ja": "ロッドレスシリンダー+両側のストロークエンドブレーキ+調整可能+マグネット+ブレーキは通常閉",
    "mn": "Саваагүй цилиндр + хоёр талдаа төгсгөлийн тоормос + тохируулгатай + соронз + ердийн хаалттай тоормос",
    "nb": "Stangløs sylinder + endebrems på begge sider + justerbar + magnet + brems normalt lukket",
    "nl": "Stangloze cilinder + eindeslagrem aan beide zijden + verstelbaar + magneet + rem normaal gesloten",
    "pl": "Cylinder beztłoczyskowy + hamulec krańcowy po obu stronach + regulowany + magnes + hamulec normalnie zamknięty",
    "pt": "Cilindro sem haste + freio de fim de curso em ambos os lados + ajustável + ímã + freio normalmente fechado",
    "pt_BR": "Cilindro sem haste + freio de fim de curso em ambos os lados + ajustável + ímã + freio normalmente fechado",
    "ro": "Cilindru fără tijă + frână de capăt de cursă pe ambele părți + reglabil + magnet + frână normal închis",
    "ru": "Бесштоковый цилиндр + тормоз конца хода с обеих сторон + регулируемый + магнит + нормально закрытый тормоз",
    "sl": "Cilinder brez droga + zavora na koncu hoda na obeh straneh + nastavljiva + magnet + zavora normalno zaprta",
    "sr": "Цилиндар без шипке + кочница на крају хода са обе стране + подесива + магнет + кочница нормално затворена",
    "tr": "Milsiz silindir + her iki tarafta strok sonu freni + ayarlanabilir + mıknatıs + normalde kapalı fren"
  },
