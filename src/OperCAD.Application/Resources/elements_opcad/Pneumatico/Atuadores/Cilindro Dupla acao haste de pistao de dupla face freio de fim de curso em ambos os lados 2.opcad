  "sourceFile": "Dupla_acao_haste_de_pistao_de_dupla_face_freio_de_fim_de_curso_em_ambos_os_lados_2.opcad",
  "id": "{5db683e7-5f60-a21e-de06-d98c27f61994}",
  "names": {
    "ar": "مزدوج الفعل + قضيب مكبس على الوجهين + فرامل نهاية الشوط على كلا الجانبين + قابل للتعديل + مغناطيس",
    "cs": "Dvoučinná + oboustranná pístnice + koncová brzda na obou stranách + nastavitelná + magnet",
    "da": "Dobbeltvirkende + dobbeltsidet stempelstang + slutbremse på begge sider + justerbar + magnet",
    "de": "Doppeltwirkend + beidseitige Kolbenstange + Endlagenbremse beidseitig + einstellbar + Magnet",
    "el": "Διπλής δράσης + ράβδος εμβόλου διπλής όψης + φρένο τέλους διαδρομής και στις δύο πλευρές + ρυθμιζόμενο + μαγνήτης",
    "en": "Double-acting + double-sided piston rod + end-of-stroke brake on both sides + adjustable + magnet",
    "es": "Doble efecto + vástago de pistón de doble cara + freno de final de carrera en ambos lados + ajustable + imán",
    "fr": "Double effet + tige de piston double face + frein de fin de course des deux côtés + réglable + aimant",
    "hr": "Dvostruko djelovanje + dvostrano klipnjača + kočnica na kraju hoda s obje strane + podesiva + magnet",
    "hu": "Kettős működésű + kétoldalas dugattyúrúd + löketvégi fék mindkét oldalon + állítható + mágnes",
    "it": "Doppio effetto + stelo pistone bilaterale + freno di fine corsa su entrambi i lati + registrabile + magnete",
    "ja": "複動式+両面ピストンロッド+両側のストロークエンドブレーキ+調整可能+磁石",
    "mn": "Давхар үйлдэлтэй + хоёр талт поршений саваа + хоёр талдаа харвалтын төгсгөлийн тоормос + тохируулгатай + соронз",
    "nb": "Dobbeltvirkende + dobbeltsidig stempelstang + endebrems på begge sider + justerbar + magnet",
    "nl": "Dubbelwerkend + dubbelzijdige zuigerstang + eindeslagrem aan beide zijden + verstelbaar + magneet",
    "pl": "Dwustronnego działania + dwustronny tłoczysko + hamulec końca suwu po obu stronach + regulowany + magnes",
    "pt": "Cilindro Dupla acao haste de pistao de dupla face freio de fim de curso em ambos os lados 2",
    "pt_BR": "Dupla ação + haste de pistão de dupla face + freio de fim de curso em ambos os lados + ajustável + ímã",
    "ro": "Dublă acțiune + tijă de piston cu două fețe + frână de capăt de cursă pe ambele părți + reglabilă + magnet",
    "ru": "Двустороннего действия + двухсторонний шток поршня + тормоз конца хода с обеих сторон + регулируемый + магнит",
    "sl": "Dvostransko delovanje + dvostranska batnica + zavora na koncu hoda na obeh straneh + nastavljiva + magnet",
    "sr": "Двострано дејство + двострано клипњача + кочница на крају хода са обе стране + подесива + магнет",
    "tr": "Çift etkili + çift taraflı piston kolu + her iki tarafta strok sonu freni + ayarlanabilir + mıknatıs"
  },
