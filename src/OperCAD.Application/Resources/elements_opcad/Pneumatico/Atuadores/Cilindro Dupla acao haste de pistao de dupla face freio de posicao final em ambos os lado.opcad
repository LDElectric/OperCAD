{
  "version": "1.0",
  "source": "opcad",
  "sourceFile": "Dupla_acao_haste_de_pistao_de_dupla_face_freio_de_posicao_final_em_ambos_os_lado.opcad",
  "id": "{4dad7c96-762c-777d-bdb1-5988465c608b}",
  "names": {
    "ar": "مزدوج الفعل + قضيب الكباس على الوجهين + فرامل الوضع النهائي على كلا الجانبين + قابل للتعديل",
    "cs": "Dvoučinná + oboustranná pístnice + brzda koncové polohy na obou stranách + nastavitelná",
    "da": "Dobbeltvirkende + dobbeltsidet stempelstang + endestillingsbremse på begge sider + justerbar",
    "de": "Doppeltwirkend + beidseitige Kolbenstange + Endlagenbremse beidseitig + einstellbar",
    "el": "Διπλής δράσης + ράβδος εμβόλου διπλής όψης + φρένο τελικής θέσης και στις δύο πλευρές + ρυθμιζόμενο",
    "en": "Double-acting + double-sided piston rod + end position brake on both sides + adjustable",
    "es": "Doble efecto + vástago de pistón de doble cara + freno de posición final en ambos lados + ajustable",
    "fr": "Double effet + tige de piston double face + frein de fin de course des deux côtés + réglable",
    "hr": "Dvostrano djelovanje + obostrano klipnjača + kočnica krajnjeg položaja s obje strane + podesiva",
    "hu": "Kettős működésű + kétoldalas dugattyúrúd + végállásfék mindkét oldalon + állítható",
    "it": "Doppio effetto + stelo pistone bilaterale + freno di fine corsa su entrambi i lati + regolabile",
    "ja": "複動式+両面ピストンロッド+両側のエンドポジションブレーキ+調整可能",
    "mn": "Давхар үйлдэлтэй + хоёр талт поршений саваа + 2 талдаа төгсгөлийн байрлал тоормос + тохируулгатай",
    "nb": "Dobbeltvirkende + dobbeltsidig stempelstang + endestillingsbrems på begge sider + justerbar",
    "nl": "Dubbelwerkend + dubbelzijdige zuigerstang + eindpositierem aan beide zijden + verstelbaar",
    "pl": "Dwustronnego działania + dwustronne tłoczysko + hamulec położenia końcowego po obu stronach + regulowany",
    "pt": "Cilindro Dupla acao haste de pistao de dupla face freio de posicao final em ambos os lado",
    "pt_BR": "Dupla ação + haste de pistão de dupla face + freio de posição final em ambos os lados + ajustável",
    "ro": "Dubla actiune + tija de piston cu doua fete + frana de pozitie finala pe ambele parti + reglabila",
    "ru": "Двустороннего действия + двухсторонний поршневой шток + тормоз конечного положения с обеих сторон + регулируемый",
    "sl": "Dvostransko delovanje + dvostranska batnica + zavora končnega položaja na obeh straneh + nastavljiva",
    "sr": "Двострано дејство + двострана клипњача + кочница крајњег положаја са обе стране + подесива",
    "tr": "Çift etkili + çift taraflı piston kolu + her iki tarafta son konum freni + ayarlanabilir"
  },
