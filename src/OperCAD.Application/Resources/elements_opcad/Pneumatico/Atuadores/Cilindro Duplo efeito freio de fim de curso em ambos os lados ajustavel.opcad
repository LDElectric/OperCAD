  "names": {
    "ar": "مزدوج الفعل + فرامل نهاية السفر على كلا الجانبين + قابل للتعديل",
    "cs": "Dvojčinná + dojezdová brzda na obou stranách + nastavitelná",
    "da": "Dobbeltvirkende + endebremse på begge sider + justerbar",
    "de": "Doppeltwirkend + Endlagenbremse beidseitig + einstellbar",
    "el": "Διπλής δράσης + φρένο τέλους διαδρομής και στις δύο πλευρές + ρυθμιζόμενο",
    "en": "Double-acting + end-of-travel brake on both sides + adjustable",
    "es": "Freno de doble efecto + final de carrera en ambos lados + ajustable",
    "fr": "Double effet + frein de fin de course des deux côtés + réglable",
    "hr": "Dvostrano djelovanje + kočnica za kraj vožnje s obje strane + podesiva",
    "hu": "Kettős működésű + végfék mindkét oldalon + állítható",
    "it": "Doppio effetto + freno di fine corsa su entrambi i lati + regolabile",
    "ja": "複動式+両側の走行終了ブレーキ+調整可能",
    "mn": "Давхар үйлдэлтэй + 2 талдаа төгсгөлийн тоормос + тохируулгатай",
    "nb": "Dobbeltvirkende + endebrems på begge sider + justerbar",
    "nl": "Dubbelwerkend + eindelooprem aan beide zijden + verstelbaar",
    "pl": "Dwustronnego działania + hamulec krańcowy po obu stronach + regulowany",
    "pt": "Cilindro Duplo efeito freio de fim de curso em ambos os lados ajustavel",
    "pt_BR": "Duplo efeito + freio de fim de curso em ambos os lados + ajustável",
    "ro": "Frână cu dublă acțiune + capăt de cursă pe ambele părți + reglabilă",
    "ru": "Двустороннего действия + концевой тормоз с обеих сторон + регулируемый",
    "sl": "Dvostransko delovanje + zavora na koncu vožnje na obeh straneh + nastavljiva",
    "sr": "Двострано дејство + кочница на крају вожње са обе стране + подесива",
    "tr": "Çift etkili + her iki tarafta hareket sonu freni + ayarlanabilir"
  },
