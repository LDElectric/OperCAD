  "sourceFile": "Dupla_acao_haste_de_pistao_de_dupla_face_freio_de_fim_de_curso_em_ambos_os_lados.opcad",
  "id": "{5d2c8411-6c69-3f0a-6948-3d3ec34a6d48}",
  "names": {
    "ar": "مزدوج الفعل + قضيب مكبس على الوجهين + فرامل نهاية الشوط على كلا الجانبين",
    "cs": "Dvoučinná + oboustranná pístnice + koncová brzda na obou stranách",
    "da": "Dobbeltvirkende + dobbeltsidet stempelstang + endebremse på begge sider",
    "de": "Doppeltwirkend + beidseitige Kolbenstange + Endlagenbremse beidseitig",
    "el": "Διπλής δράσης + ράβδος εμβόλου διπλής όψης + φρένο τέλους διαδρομής και στις δύο πλευρές",
    "en": "Double-acting + double-sided piston rod + end-of-stroke brake on both sides",
    "es": "Doble efecto + vástago de pistón de doble cara + freno de final de carrera en ambos lados",
    "fr": "Double effet + tige de piston double face + frein de fin de course des deux côtés",
    "hr": "Dvostrano djelovanje + dvostrana klipnjača + kočnica na kraju hoda s obje strane",
    "hu": "Kettős működésű + kétoldalas dugattyúrúd + löketvégi fék mindkét oldalon",
    "it": "Doppio effetto + stelo pistone bilaterale + freno di fine corsa su entrambi i lati",
    "ja": "複動式+両面ピストンロッド+両側のストロークエンドブレーキ",
    "mn": "Хоёр талдаа давхар үйлдэлтэй + хоёр талт поршений саваа + цохилтын төгсгөлийн тоормос",
    "nb": "Dobbeltvirkende + dobbeltsidig stempelstang + endebrems på begge sider",
    "nl": "Dubbelwerkend + dubbelzijdige zuigerstang + eindeslagrem aan beide zijden",
    "pl": "Dwustronnego działania + dwustronne tłoczysko + hamulec końca suwu po obu stronach",
    "pt": "Cilindro Dupla acao haste de pistao de dupla face freio de fim de curso em ambos os lados",
    "pt_BR": "Dupla ação + haste de pistão de dupla face + freio de fim de curso em ambos os lados",
    "ro": "Dublă acțiune + tijă de piston cu două fețe + frână de capăt de cursă pe ambele părți",
    "ru": "Двустороннего действия + двухсторонний поршневой шток + тормоз конца хода с обеих сторон",
    "sl": "Dvostransko delovanje + dvostranska batnica + zavora na koncu hoda na obeh straneh",
    "sr": "Двострано дејство + двострана клипњача + кочница на крају хода са обе стране",
    "tr": "Çift etkili + çift taraflı piston kolu + her iki tarafta strok sonu freni"
  },
